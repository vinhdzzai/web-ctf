<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= title %></title>
    <style>
      *{box-sizing:border-box}html,body{min-height:100%;margin:0}body{position:relative;isolation:isolate;min-height:100vh;overflow-x:hidden;background:#111729;color:#e6e8f0;font:13px/1.45 Arial,Verdana,sans-serif}
      .space-background{position:fixed;inset:0;z-index:-1;overflow:hidden;pointer-events:none;background:#111729}.space-nebula{position:absolute;inset:-45%;background-image:radial-gradient(ellipse at 25% 34%,rgba(81,91,164,.42),transparent 31%),radial-gradient(ellipse at 73% 61%,rgba(43,112,143,.32),transparent 29%),radial-gradient(ellipse at 59% 18%,rgba(111,65,135,.27),transparent 25%);animation:nebula 55s ease-in-out infinite alternate}
      .star-layer{position:absolute;inset:-50%;background-repeat:repeat}.star-far{background-image:radial-gradient(1px 1px at 23px 46px,rgba(224,232,255,.8) 98%,transparent),radial-gradient(1px 1px at 91px 122px,rgba(182,200,255,.72) 98%,transparent),radial-gradient(1px 1px at 167px 28px,rgba(255,255,255,.78) 98%,transparent);background-size:190px 160px,230px 210px,280px 240px;animation:drift-left 100s linear infinite}.star-near{inset:-30%;background-image:radial-gradient(2px 2px at 43px 67px,rgba(255,255,255,.95) 98%,transparent),radial-gradient(1px 1px at 133px 154px,rgba(190,218,255,.9) 98%,transparent),radial-gradient(2px 2px at 207px 31px,rgba(218,211,255,.84) 98%,transparent);background-size:310px 260px,370px 330px,440px 390px;animation:drift-right 68s linear infinite}
      .ship{position:absolute;left:-90px;width:58px;height:20px;background:#c7d6f1;clip-path:polygon(0 39%,56% 39%,78% 0,100% 50%,78% 100%,56% 61%,0 61%,13% 50%);animation:ship 32s linear infinite}.ship:before{position:absolute;top:8px;left:-38px;width:42px;height:3px;background:linear-gradient(90deg,transparent,rgba(114,173,221,.68));content:""}.ship-one{top:26%}.ship-two{top:72%;left:auto;right:-90px;width:43px;height:15px;background:#b9c8df;animation:ship-back 43s linear 7s infinite}.ship-window{position:absolute;top:7px;left:37px;width:7px;height:6px;background:#526b9c}.ship-two .ship-window{top:5px;left:26px;width:6px;height:5px}.meteor{position:absolute;top:16%;left:68%;width:110px;height:2px;background:linear-gradient(90deg,rgba(194,214,255,.9),transparent);transform:rotate(-28deg);transform-origin:left center;animation:meteor 12s linear 3s infinite}
      @keyframes nebula{to{transform:translate3d(2%,-1%,0) scale(1.06)}}@keyframes drift-left{to{transform:translate3d(-5%,3%,0)}}@keyframes drift-right{to{transform:translate3d(6%,-4%,0)}}@keyframes ship{20%{transform:translate3d(25vw,-12px,0)}70%{transform:translate3d(80vw,10px,0)}100%{transform:translate3d(calc(100vw + 180px),-5px,0)}}@keyframes ship-back{35%{transform:translate3d(-38vw,12px,0) scaleX(-1)}100%{transform:translate3d(calc(-100vw - 180px),-10px,0) scaleX(-1)}}@keyframes meteor{0%,78%{opacity:0;transform:translate3d(0,0,0) rotate(-28deg)}80%{opacity:1}88%,100%{opacity:0;transform:translate3d(-210px,120px,0) rotate(-28deg)}}
      .shell{max-width:1000px;margin:0 18px}.masthead{padding:22px 0 12px;border-bottom:1px solid #59627b}.masthead h1{margin:0;color:#f2f4fc;font-size:22px}.eyebrow{margin:0 0 4px;color:#d0d8ee;font-size:11px;font-weight:bold}.subheading{margin:4px 0 0;color:#d0d5e4}.content{max-width:760px;padding-top:18px}.panel{min-width:0;margin:0 0 14px;padding:12px;border:1px solid #888;background:#f0eff7;color:#222;transition:transform 180ms ease,border-color 180ms ease}.panel:hover{transform:translateY(-1px);border-color:#777b9b}.panel legend{padding:0 6px;background:#f0eff7;color:#29283a;font-size:12px;font-weight:bold}.panel p{margin:0 0 9px}.login-panel,.notice-panel{max-width:490px}.notice{padding:7px;border:1px solid #b6b5c5;background:#e9e9f2}.form-row{margin:0 0 10px}.form-row label{display:block;margin-bottom:3px;font-size:12px}.form-row input{width:100%;padding:5px;border:1px solid #777;border-radius:0;background:#fff;font:inherit}.button{padding:4px 12px;border:1px solid #777;border-radius:0;background:#e5e5e5;color:#222;font:inherit;cursor:pointer}.button:hover{background:#d8d8d8}.error{color:#a40000;font-weight:bold}.online{color:#176b17;font-weight:bold}.footer{margin-top:18px;padding:8px 0 20px;border-top:1px solid #59627b;color:#d0d5e4;font-size:11px}.session{float:right;color:#d1d5e2}.article{margin:0 0 12px;padding:8px;border-bottom:1px solid #aaa;background:#f0eff7;color:#222;transition:background-color 180ms ease}.article:hover{background:#e6e5f0}.article h2{margin:0 0 4px;color:#45475a;font-size:16px}.article p{margin:0 0 6px}.muted{color:#666;font-size:11px}.admin-form textarea{display:block;width:100%;min-height:240px;margin:8px 0;padding:8px;border:1px solid #777;border-radius:0;background:#fff;color:#222;font:12px/1.45 Consolas,monospace}
      @media(max-width:650px){.shell{margin:0 10px}.session{float:none;display:block;margin-top:8px}.masthead h1{font-size:20px}}@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}}
    </style>
  </head>
  <body>
    <div class="space-background" aria-hidden="true">
      <div class="space-nebula"></div><div class="star-layer star-far"></div><div class="star-layer star-near"></div>
      <div class="ship ship-one"><span class="ship-window"></span></div><div class="ship ship-two"><span class="ship-window"></span></div><div class="meteor"></div>
    </div>
